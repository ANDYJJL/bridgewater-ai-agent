# Copy to .env and fill in your own values. Never commit a real .env.

# University LLM gateway (OpenAI-compatible endpoint used in the course)
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_BASE_URL=https://llm-gateway.example.edu/v1

# Direct provider keys (optional — used by tools/llm_client.py fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Market / macro data providers (scripts/collect_real_raw_data.py)
FRED_API_KEY=
ALPHAVANTAGE_API_KEY=

# ChatGPT/Codex OAuth helper (utils/oauth_gpt.py) — optional
OPENAI_CODEX_CLIENT_ID=
